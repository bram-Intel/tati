# -----------------------------------------------------------------------------
# TATI (bytatistudio.com) — Environment Variables for Vercel Deployment
# Copy to .env.local for local development and add to Vercel Project Settings.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SITE_URL=https://bytatistudio.com

# --- Firebase Client SDK (Browser / Optional Analytics & Auth) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (Serverless API Routes -> Firestore) ---
# Option A (Recommended for Vercel): Single-line JSON of your service account key
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: Separate fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Zoho Mail SMTP (Transactional & Notification Mailer) ---
# US: smtp.zoho.com | EU: smtp.zoho.eu | IN: smtp.zoho.in
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=hello@bytatistudio.com
# Generate an App-Specific Password in Zoho Accounts -> Security -> App Passwords
ZOHO_SMTP_PASS=
ZOHO_FROM_NAME=Tati Studio
ZOHO_FROM_EMAIL=hello@bytatistudio.com
ZOHO_STUDIO_INBOX=hello@bytatistudio.com

# --- Zoho Campaigns / Newsletter List Sync (Optional) ---
# Provide either a Zoho Flow/Campaigns Webhook URL OR OAuth credentials + List Key
ZOHO_CAMPAIGNS_WEBHOOK_URL=
ZOHO_CAMPAIGNS_LIST_KEY=
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REFRESH_TOKEN=
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_CAMPAIGNS_DOMAIN=https://campaigns.zoho.com
